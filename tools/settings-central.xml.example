<?xml version="1.0" encoding="UTF-8"?>
<!--
  发布到 Maven Central 需要的凭据模板。

  用法：
    1. 复制到 ~/.m2/settings.xml（已有 settings.xml 就只把 <servers> 里的
       <server> 合并进去）
    2. 用户名/密码换成 Central Portal 的 **User Token**（不是登录密码）：
       https://central.sonatype.com/ → 右上角头像 → View User Token
    3. <id> 必须和 pom.xml 里 central-publishing-maven-plugin 的
       <publishingServerId>central</publishingServerId> 一致

  注意：这个文件里没有明文的登录密码，只有可随时吊销的 token；
  不要把它提交进仓库（真实的 ~/.m2/settings.xml 本来就在仓库外）。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <server>
            <id>central</id>
            <username>REPLACE_WITH_PORTAL_TOKEN_USERNAME</username>
            <password>REPLACE_WITH_PORTAL_TOKEN</password>
        </server>
    </servers>

    <!-- 国内网络直连 repo.maven.apache.org 常超时，按需打开：
    <proxies>
        <proxy>
            <id>local-clash</id>
            <active>true</active>
            <protocol>https</protocol>
            <host>127.0.0.1</host>
            <port>7897</port>
        </proxy>
    </proxies>
    -->
</settings>
